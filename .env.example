# Public Supabase connection values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only Supabase credentials (never expose real values in Git)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Initial admin account used by scripts/create-admin.mjs
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Bluehost cPanel enquiry email notifications (server-only)
SMTP_HOST=mail.your-domain.com
SMTP_PORT=465
SMTP_USER=contact@fathudives.com
SMTP_PASSWORD=your-mailbox-password
CONTACT_EMAIL=contact@fathudives.com
