# =============================================================================
# Fathu Dives — environment variables
# =============================================================================
# Copy this file to `.env.local` and fill in the values. Supabase is required;
# production content does not silently fall back to local sample data.

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key (safe to expose in the browser).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional service-role key for trusted server maintenance only. The CMS uses
# authenticated sessions and RLS. Never expose this in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical site URL used for SEO metadata and sitemaps.
NEXT_PUBLIC_SITE_URL=https://fathudives.com
